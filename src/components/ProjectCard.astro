---
import { t, localizePath, type Locale, type UiKey } from '../i18n/ui';
import type { Project } from '../lib/content';
import { urlFor } from '../lib/sanity';
interface Props { project: Project; locale: Locale; eager?: boolean; hasCase?: boolean }
const { project: p, locale, eager = false, hasCase = false } = Astro.props;
const tr = t(locale);
const img = urlFor(p.screenshot).width(1200).height(750).fit('crop').url();
// Two-column grid at md+, full width below: a phone needs ~400 CSS px, so a 1200w floor
// made it fetch a desktop crop. Small candidates let `sizes` pick an honest one.
const srcset = [600, 900, 1200, 2000]
  .map((w) => `${urlFor(p.screenshot).width(w).height(Math.round(w / 1.6)).fit('crop').url()} ${w}w`)
  .join(', ');
const name = p.title.split(' — ')[0];
const caseHref = hasCase ? localizePath(`/work/${p.slug}`, locale) : null;
const live = p.status === 'live' && p.url ? p.url : null;
// No destination → no anchor. An <a> without href is unfocusable and confusing to assistive tech.
const link = caseHref ? { href: caseHref } : live ? { href: live, target: '_blank', rel: 'noopener', 'data-outbound': p.slug } : null;
const Tag = link ? 'a' : 'div';
---
<article data-kind={p.kind} class="flex">
  <Tag {...link} class="card flex w-full flex-col gap-4">
    <div class="aspect-[16/10] overflow-hidden rounded-xl bg-paper-pure">
      <img class="img size-full object-cover object-top" src={img} srcset={srcset} sizes="(min-width: 768px) 50vw, 100vw" width="1200" height="750" alt={`${tr('work.screenshotOf')} ${name}`} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    </div>
    <div class="flex grow flex-col gap-2 px-2 pb-2">
      <span class="eyebrow">{tr(`work.kind.${p.kind}` as UiKey)}{p.year ? ` · ${p.year}` : ''}</span>
      <h2 class="text-[26px] leading-tight font-bold tracking-[-0.025em]">{name}</h2>
      <p class="text-[15px] text-ink-mut">{p.summary}</p>
      {link && <span class="mt-auto pt-2 text-[15px] font-semibold text-accent">{caseHref ? `${tr('work.caseStudy')} →` : `${tr('work.viewSite')} ↗`}</span>}
      {!link && p.status === 'parked' && <span class="mt-auto pt-2 text-[15px] text-ink-soft">{tr('work.parked')}</span>}
    </div>
  </Tag>
</article>
