---
// Closing call to action shared by Home, Services and About.
import { t, type Locale } from '../i18n/ui';
import { site } from '../config/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);
---
<section id="contact" class="relative overflow-hidden">
  <div aria-hidden="true" class="pointer-events-none absolute -bottom-[260px] left-1/2 h-[600px] w-[900px] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgb(255_92_46/0.2)_0%,transparent_60%)]"></div>
  <div class="wrap relative flex flex-col items-start gap-7 pt-32 pb-16">
    <h2 class="text-[clamp(48px,8.5vw,136px)] leading-[0.9] font-black tracking-[-0.045em] uppercase" style="font-stretch: 112%">
      {tr('home.contact.title1')}<br /><span class="text-transparent [-webkit-text-stroke:1.5px_var(--color-ink)]">{tr('home.contact.title2')}</span>
    </h2>
    <p class="max-w-[560px] text-[19px] text-ink-mut">{tr('home.contact.text')}</p>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
      <a href={`mailto:${site.email}`} class="btn-primary px-7! py-[18px]! text-[17px]" data-cta="contact-email">{site.email}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
      {site.calUrl && <a href={site.calUrl} target="_blank" rel="noopener" class="border-b border-[#3a3f48] pb-0.5 font-semibold hover:text-accent" data-book>{tr('home.contact.book')}</a>}
    </div>
  </div>
</section>
