---
import { t, type Locale } from '../i18n/ui';
import { site } from '../config/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);
const year = new Date().getFullYear();
---
<footer class="wrap">
  <div class="flex flex-wrap justify-between gap-x-8 gap-y-3 border-t border-line-2 pt-6 pb-10 text-sm text-ink-soft">
    <span>© {year} Jose Uribe · {tr('footer.location')}</span>
    <ul class="flex flex-wrap gap-6">
      <li><a href={site.github} rel="me noopener" target="_blank" class="text-ink-mut hover:text-accent" data-social="github">GitHub</a></li>
      <li><a href={site.linkedin} rel="me noopener" target="_blank" class="text-ink-mut hover:text-accent" data-social="linkedin">LinkedIn</a></li>
      <li><a href={site.upwork} rel="me noopener" target="_blank" class="text-ink-mut hover:text-accent" data-social="upwork">Upwork</a></li>
    </ul>
  </div>
</footer>
