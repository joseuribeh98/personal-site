---
import Base from '../layouts/Base.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { t, localizePath, LANG_NAMES, LANG_TAGS, type Locale } from '../i18n/ui';
import { otherTranslations, type Post } from '../lib/content';
import { urlFor } from '../lib/sanity';
import { renderPortableText } from '../lib/portable-text';
import { articleJsonLd } from '../lib/seo';
interface Props { locale: Locale; post: Post }
const { locale, post } = Astro.props;
const tr = t(locale);
const html = await renderPortableText(post.body, { imageUrl: (b) => urlFor(b as any).width(1400).url() });
const others = otherTranslations(post, locale);
const alternates: Partial<Record<Locale, string>> = { [locale]: localizePath(`/blog/${post.slug}`, locale) };
for (const o of others) alternates[o.language] = localizePath(`/blog/${o.slug}`, o.language);
const date = new Date(post.publishedAt).toLocaleDateString(LANG_TAGS[locale], { year: 'numeric', month: 'long', day: 'numeric' });
const og = post.cover ? urlFor(post.cover).width(1200).height(630).fit('crop').url() : undefined;
---
<Base {locale} title={`${post.title} — Jose Uribe`} description={post.excerpt} {alternates} ogImage={og} jsonLd={articleJsonLd(post, locale)} fallbackPath="/blog">
  <article class="wrap max-w-[860px] pt-10 pb-24 md:pt-14">
    <a href={localizePath('/blog', locale)} class="inline-flex items-center gap-2 text-[15px] font-semibold text-ink-mut hover:text-accent">
      <svg class="rotate-180" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>{tr('blog.back')}
    </a>
    <p class="eyebrow fade-1 mt-10"><time datetime={post.publishedAt}>{date}</time></p>
    <h1 class="rise-1 mt-4 text-display-lg leading-[1.02] text-balance">{post.title}</h1>
    <p class="fade-2 mt-5 text-[19px] text-ink-mut text-pretty">{post.excerpt}</p>
    {others.length > 0 && (
      <p class="mt-5 text-sm text-ink-mut">{tr('blog.alsoIn')} {others.map((o, i) => <><a href={alternates[o.language]} hreflang={LANG_TAGS[o.language]} class="text-accent underline underline-offset-4">{LANG_NAMES[o.language]}</a>{i < others.length - 1 ? ', ' : ''}</>)}</p>
    )}
    {post.cover && <img src={urlFor(post.cover).width(1400).height(788).fit('crop').url()} alt="" width="1400" height="788" loading="eager" decoding="async" class="mt-10 w-full rounded-[20px] border border-line" />}
    <div class="prose-site mt-12" set:html={html} />
  </article>
  <ContactBlock {locale} />
</Base>
