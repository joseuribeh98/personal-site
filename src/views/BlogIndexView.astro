---
import Base from '../layouts/Base.astro';
import PostTile from '../components/PostTile.astro';
import { t, type Locale } from '../i18n/ui';
import { getPosts } from '../lib/sanity';
interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);
const posts = await getPosts(locale);
---
<Base {locale} title={tr('blog.metaTitle')} description={tr('blog.metaDescription')}>
  <section class="wrap flex flex-col gap-7 pt-14 pb-16 md:pt-20">
    <h1 class="rise-1 text-display-xl leading-none tracking-[-0.04em]">{tr('blog.title')}</h1>
    <p class="fade-2 max-w-[620px] text-[19px] text-ink-mut text-pretty">{tr('blog.lead')}</p>
  </section>
  <section class="wrap pb-28">
    {posts.length === 0
      ? <p class="rounded-[20px] border border-dashed border-line px-8 py-10 text-ink-mut" data-empty>{tr('blog.empty')}</p>
      : <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">{posts.map((post, i) => <PostTile {post} {locale} index={i} as="h2" />)}</div>}
  </section>
</Base>
