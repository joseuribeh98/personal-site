---
import Base from '../layouts/Base.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { t, localizePath, type Locale, type UiKey } from '../i18n/ui';
import type { Project } from '../lib/content';
import { urlFor } from '../lib/sanity';
import { renderPortableText } from '../lib/portable-text';
import { creativeWorkJsonLd } from '../lib/seo';
interface Props { locale: Locale; project: Project }
const { locale, project: p } = Astro.props;
const tr = t(locale);
const html = await renderPortableText(p.caseStudy ?? [], { imageUrl: (b) => urlFor(b as any).width(1400).url() });
const hero = urlFor(p.screenshot).width(1600).height(1000).fit('crop').url();
const hero2x = urlFor(p.screenshot).width(2800).height(1750).fit('crop').url();
const name = p.title.split(' — ')[0];
const live = p.status === 'live' && p.url;
const facts = [
  [tr('work.client'), p.client],
  [tr('work.role'), p.role],
  [tr('work.year'), p.year ? String(p.year) : undefined],
  [tr('work.stack'), p.stack?.join(' · ')],
].filter(([, v]) => v) as [string, string][];
const arrow = 'M5 12h14M13 6l6 6-6 6';
---
<Base {locale} title={`${name} — Jose Uribe`} description={p.summary} ogImage={urlFor(p.screenshot).width(1200).height(630).fit('crop').url()} jsonLd={creativeWorkJsonLd(p, locale)}>
  <article>
    <header class="wrap flex flex-col gap-7 pt-10 pb-12 md:pt-14">
      <a href={localizePath('/work', locale)} class="inline-flex items-center gap-2 self-start text-[15px] font-semibold text-ink-mut hover:text-accent">
        <svg class="rotate-180" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg>{tr('work.back')}
      </a>
      <span class="eyebrow fade-1">{tr(`work.kind.${p.kind}` as UiKey)}{p.year ? ` · ${p.year}` : ''}</span>
      <h1 class="fade-1 text-display-xl leading-none tracking-[-0.04em]">{name}</h1>
      <p class="fade-2 max-w-[680px] text-[19px] text-ink-mut text-pretty">{p.summary}</p>
      {live && <a href={p.url!} target="_blank" rel="noopener" class="btn-primary fade-3 self-start" data-outbound={p.slug}>{tr('work.viewSite')}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9" /></svg></a>}
    </header>

    <div class="wrap">
      <div class="slide-in overflow-hidden rounded-3xl border border-line bg-paper-2 p-3.5">
        <img src={hero} srcset={`${hero} 1600w, ${hero2x} 2800w`} sizes="(min-width: 1320px) 1290px, 100vw" width="1600" height="1000" alt={`${tr('work.screenshotOf')} ${name}`} loading="eager" decoding="async" class="w-full rounded-2xl" />
      </div>
    </div>

    <div class="wrap grid gap-x-16 gap-y-10 py-20 lg:grid-cols-[1fr_2fr]">
      <dl class="flex flex-col self-start">
        {facts.map(([k, v]) => (
          <div class="border-t border-line py-3.5">
            <dt class="eyebrow">{k}</dt>
            <dd class="mt-1.5">{v}</dd>
          </div>
        ))}
      </dl>
      <div class="prose-site" set:html={html} />
    </div>
  </article>
  <ContactBlock {locale} />
</Base>
