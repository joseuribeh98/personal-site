---
import Base from '../layouts/Base.astro';
import HeroFigure from '../components/HeroFigure.astro';
import ContactBlock from '../components/ContactBlock.astro';
import PostTile from '../components/PostTile.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { t, localizePath, type Locale, type UiKey } from '../i18n/ui';
import type { Project } from '../lib/content';
import { getProjects, getCaseStudySlugs, getPosts, urlFor } from '../lib/sanity';
import { personJsonLd, websiteJsonLd } from '../lib/seo';
interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);

const [projects, caseSlugs, posts] = await Promise.all([getProjects(locale), getCaseStudySlugs(), getPosts(locale)]);
// Featured first, then whatever is live, in Studio order. The Studio decides; the Home never hardcodes slugs.
const shown = [...projects.filter((p) => p.featured), ...projects.filter((p) => !p.featured && p.status === 'live')].slice(0, 4);
const [lead, ...rest] = shown;
const latest = posts.slice(0, 3);

const kindLabel = (p: Project) => tr(`work.kind.${p.kind}` as UiKey);
const hrefFor = (p: Project) =>
  caseSlugs.includes(p.slug) ? { href: localizePath(`/work/${p.slug}`, locale) } : p.status === 'live' && p.url ? { href: p.url, target: '_blank', rel: 'noopener', 'data-outbound': p.slug } : null;
const img = (p: Project, w: number, h: number) => urlFor(p.screenshot).width(w).height(h).fit('crop').url();

const stack = ['Next.js', 'NestJS', 'TypeScript', 'PostgreSQL', 'Azure', 'Astro', 'Supabase', 'Cloudflare', tr('home.marquee.ai'), tr('home.marquee.product'), tr('home.marquee.zero')];
const flow = [1, 2, 3, 4].map((n) => [tr(`home.flow.s${n}.title` as UiKey), tr(`home.flow.s${n}.text` as UiKey)]);
const arrow = 'M5 12h14M13 6l6 6-6 6';
---
<Base {locale} title={tr('home.metaTitle')} description={tr('home.metaDescription')} jsonLd={[personJsonLd(), websiteJsonLd(locale)]}>
  <!-- Hero -->
  <section class="wrap grid items-end gap-x-14 gap-y-10 pt-10 pb-20 lg:grid-cols-2">
    <div class="flex min-w-0 flex-col gap-9 pb-6">
      <p class="fade-1 text-ink-mut">{tr('home.helloPre')} <strong class="font-bold text-ink">Jose Uribe</strong>. {tr('home.helloPost')}</p>
      <h1 class="fade-2 text-display-xl leading-none tracking-[-0.04em] text-balance">
        {tr('home.h1Pre')} <span class="relative inline-block whitespace-nowrap">{tr('home.h1Mark')}<svg class="draw absolute -bottom-[0.12em] -left-[4%] h-[0.32em] w-[108%] overflow-visible" viewBox="0 0 300 40" preserveAspectRatio="none" aria-hidden="true"><path d="M6 30 C 70 8, 150 6, 294 22" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" class="text-accent" /></svg></span> {tr('home.h1Post')}
      </h1>
      <p class="fade-3 max-w-[520px] text-[19px] text-ink-mut text-pretty">{tr('home.sub')}</p>
      <div class="fade-3 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a href="#work" class="btn-primary" data-cta="hero-work">{tr('home.ctaPrimary')}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></a>
        <a href="#contact" class="border-b border-[#3a3f48] pb-0.5 font-semibold hover:text-accent" data-cta="hero-contact">{tr('home.ctaSecondary')}</a>
      </div>
    </div>
    <HeroFigure {locale} />
  </section>

  <!-- Stack marquee -->
  <div aria-hidden="true" class="overflow-hidden border-y border-line-2 py-4 whitespace-nowrap">
    <div class="marquee inline-flex gap-12 font-mono text-[13px] tracking-[0.06em] text-ink-soft uppercase will-change-transform">
      {[0, 1].map(() => stack.map((s) => <><span>{s}</span><span class="text-accent">●</span></>))}
    </div>
  </div>

  <!-- Now -->
  <section id="now" class="wrap grid items-center gap-x-16 gap-y-14 py-28 lg:grid-cols-2">
    <div class="flex flex-col gap-6">
      <h2 class="text-display-lg leading-[1.02] text-balance" data-words>{tr('home.now.title')}</h2>
      <p class="max-w-[520px] text-lg text-ink-mut text-pretty">{tr('home.now.text')}</p>
    </div>
    <div class="flex flex-col gap-7 rounded-3xl border border-line bg-paper-2 px-8 py-9">
      <p class="eyebrow">{tr('home.flow.title')}</p>
      <div class="relative h-3.5" aria-hidden="true">
        <div class="absolute inset-x-0 top-1.5 h-0.5 bg-line"></div>
        <div class="travel absolute top-0 size-3.5 rounded-full bg-accent shadow-[0_0_18px_rgb(255_92_46/0.8)]"></div>
      </div>
      <ol class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        {flow.map(([title, text], i) => (
          <li class="flex min-w-0 flex-col gap-1.5">
            <span class:list={['font-mono text-xs', i === 3 ? 'text-accent' : 'text-ink-soft']}>0{i + 1}</span>
            <span class:list={['text-[15px] font-bold tracking-[-0.02em]', i === 3 && 'text-accent']}>{title}</span>
            <span class="text-[13px] text-ink-mut">{text}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Blog -->
  <section id="blog" class="wrap flex flex-col gap-10 pb-28">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
      <h2 class="text-display-lg leading-[1.02]" data-reveal>{tr('home.blog.title')}</h2>
      <a href={localizePath('/blog', locale)} class="inline-flex items-center gap-2 py-2 text-[15px] font-semibold hover:text-accent">{tr('home.blog.all')}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></a>
    </div>
    {latest.length > 0 ? (
      <div class="grid gap-6 md:grid-cols-3">
        {latest.map((post, i) => (
          <PostTile {post} {locale} index={i} />
        ))}
      </div>
    ) : (
      <p class="rounded-[20px] border border-dashed border-line px-8 py-10 text-ink-mut">{tr('home.blog.empty')}</p>
    )}
  </section>

  <!-- Work -->
  <section id="work" class="wrap flex flex-col gap-10 pb-28">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
      <h2 class="text-display-lg leading-[1.02]" data-reveal>{tr('home.work.title')}</h2>
      <a href={localizePath('/work', locale)} class="inline-flex items-center gap-2 py-2 text-[15px] font-semibold hover:text-accent">{tr('home.work.all')}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></a>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {lead && (() => {
        const link = hrefFor(lead);
        const Tag = link ? 'a' : 'div';
        return (
          <Tag {...link} class="card grid items-center gap-6 rounded-3xl md:col-span-3 md:grid-cols-2">
            <div class="aspect-[16/10] overflow-hidden rounded-2xl bg-paper-pure">
              <img class="img size-full object-cover object-top" src={img(lead, 1200, 750)} srcset={`${img(lead, 1200, 750)} 1200w, ${img(lead, 2000, 1250)} 2000w`} sizes="(min-width: 768px) 50vw, 100vw" width="1200" height="750" alt={`${tr('work.screenshotOf')} ${lead.title}`} loading="lazy" decoding="async" />
            </div>
            <div class="flex flex-col gap-3.5 py-4 pr-6 pl-2">
              <div class="flex flex-wrap gap-2">
                <span class="rounded-full bg-accent-soft px-2.5 py-1.5 font-mono text-xs text-accent">{tr('home.work.featured')}</span>
                <span class="rounded-full border border-line px-2.5 py-1.5 font-mono text-xs text-ink-mut">{kindLabel(lead)}</span>
                {lead.status === 'live' && <span class="rounded-full border border-line px-2.5 py-1.5 font-mono text-xs text-ink-mut">{tr('home.work.live')}</span>}
              </div>
              <h3 class="text-[clamp(26px,2.6vw,36px)] leading-[1.05] tracking-[-0.03em]">{lead.title.split(' — ')[0]}</h3>
              <p class="text-ink-mut">{lead.summary}</p>
              {link && <span class="text-[15px] font-semibold text-accent">{caseSlugs.includes(lead.slug) ? tr('home.work.case') : tr('home.work.visit')} →</span>}
            </div>
          </Tag>
        );
      })()}
      {rest.map((p) => {
        const link = hrefFor(p);
        const Tag = link ? 'a' : 'div';
        return (
          <Tag {...link} class="card flex flex-col gap-4">
            <div class="aspect-[4/3] overflow-hidden rounded-xl bg-paper-pure">
              <img class="img size-full object-cover object-top" src={img(p, 800, 600)} width="800" height="600" alt={`${tr('work.screenshotOf')} ${p.title}`} loading="lazy" decoding="async" />
            </div>
            <div class="flex flex-col gap-1.5 px-2 pb-2">
              <span class="eyebrow">{kindLabel(p)}{p.year ? ` · ${p.year}` : ''}</span>
              <h3 class="text-[22px] leading-tight font-bold tracking-[-0.025em]">{p.title.split(' — ')[0]}</h3>
              <p class="line-clamp-3 text-[15px] text-ink-mut">{p.summary}</p>
            </div>
          </Tag>
        );
      })}
    </div>
  </section>

  <!-- Services: the one light block -->
  <section id="services" class="bg-light text-light-ink">
    <div class="wrap flex flex-col gap-12 py-28">
      <div class="grid items-end gap-x-16 gap-y-6 lg:grid-cols-2">
        <h2 class="text-display-lg leading-[1.02] text-balance" data-reveal>{tr('home.services.title')}</h2>
        <p class="max-w-[520px] text-lg text-light-mut text-pretty">{tr('home.services.lead')}</p>
      </div>
      <div class="grid gap-5 md:grid-cols-3">
        {([1, 2, 3] as const).map((n) => (
          <div class="flex min-h-[280px] flex-col gap-4.5 rounded-[20px] border border-light-line bg-light-card p-8">
            <ServiceIcon {n} class="bg-light-ink" />
            <h3 class="text-2xl leading-[1.1] tracking-[-0.03em]">{tr(`home.s${n}.title` as UiKey)}</h3>
            <p class="grow text-light-mut">{tr(`home.s${n}.text` as UiKey)}</p>
            <span class="font-mono text-xs text-light-mut">{tr(`home.s${n}.tags` as UiKey)}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ContactBlock {locale} />

  <script>
    import '../scripts/motion.ts';
  </script>
</Base>
