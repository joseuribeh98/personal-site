---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';
const tr = t('es');
---
<Base locale="es" title={`${tr('notFound.title')} — Jose Uribe`} description={tr('notFound.text')} noindex>
  <section class="wrap flex min-h-[60vh] flex-col items-start justify-center gap-7 py-24">
    <p class="eyebrow">404</p>
    <h1 class="text-display-xl leading-none tracking-[-0.04em]">{tr('notFound.title')}</h1>
    <p class="max-w-[520px] text-[19px] text-ink-mut">{tr('notFound.text')}</p>
    <a href="/" class="btn-primary">{tr('notFound.home')}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
  </section>
</Base>
